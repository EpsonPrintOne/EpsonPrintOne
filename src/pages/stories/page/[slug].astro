---
import StoryCard from "@/components/StoryCard.astro";
import Pagination from "@/components/Pagination.astro";
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import { getListPage, getSinglePage } from "@/lib/contentParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";
import PageHeader from "@/partials/PageHeader.astro";

export async function getStaticPaths() {
  const stories = await getSinglePage("stories");
  const totalPages = Math.ceil(stories.length / config.settings.pagination);
  const paths = [...Array(totalPages).keys()].map((i) => ({
    params: { slug: String(i + 1) },
  }));

  return paths;
}

const { slug } = Astro.params;
const { stories_folder } = config.settings;

const storiesIndex = await getListPage("stories", "-index");
const buildDrafts = process.argv.includes("--buildDrafts");
if (!buildDrafts && storiesIndex.data.draft) return Astro.redirect("/404");
const stories = await getSinglePage("stories");
const sortedStories = sortByDate(stories);
const totalPages = Math.ceil(stories.length / config.settings.pagination);
const currentPage = slug && !isNaN(Number(slug)) ? Number(slug) : 1;
const indexOfLastStory = currentPage * config.settings.pagination;
const indexOfFirstStory = indexOfLastStory - config.settings.pagination;
const currentStories = sortedStories.slice(indexOfFirstStory, indexOfLastStory);
---

<Base {...storiesIndex.data}>
  <PageHeader
    title={storiesIndex.data.title}
    subtitle={storiesIndex.data.subtitle}
  />

  <section class="section">
    <div class="container">
      <div class="row">
        {
          currentStories.map((story) => (
            <div class="mb-14 md:col-6 lg:col-4">
              <StoryCard {...story} />
            </div>
          ))
        }
      </div>
      <Pagination
        section={stories_folder}
        currentPage={currentPage}
        totalPages={totalPages}
      />
    </div>
  </section>
</Base>
