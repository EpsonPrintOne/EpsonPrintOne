---
import PEABenefitStrip from "@/components/pea/PEABenefitStrip.astro";
import PEAFAQ from "@/components/pea/PEAFAQ.astro";
import PEAFinalCTA from "@/components/pea/PEAFinalCTA.astro";
import PEAHero from "@/components/pea/PEAHero.astro";
import PEAProductGrid from "@/components/pea/PEAProductGrid.astro";
import PEASavingsShowcase from "@/components/pea/PEASavingsShowcase.astro";
import PEAWhyAdvantage from "@/components/pea/PEAWhyAdvantage.astro";
import { maxDiscount, minDiscount, productCount, promoEndDate } from "@/data/epsonAdvantageProducts";
import PEAPromoBanner from "@/components/pea/PEAPromoBanner.astro";
import Base from "@/layouts/Base.astro";
---

<Base
  title="Print-IQ Epson Advantage Program"
  meta_title="Print-IQ Epson Advantage Program | Exclusive Epson Prices for Print-IQ Customers"
  description={`Print-IQ customers save ${minDiscount}% to ${maxDiscount}% on ${productCount} selected Epson products. See your Epson Advantage price and buy online.`}
  image="/images/pea/epson-advantage-badge.jpg"
>
  <PEAPromoBanner variant="strip" class="rounded-none" />
  <PEAHero />
  <PEABenefitStrip />
  <PEAProductGrid />
  <PEAWhyAdvantage />
  <PEASavingsShowcase />

  <section class="bg-white py-12 text-center">
    <div class="container">
      <h2 class="mb-2">{productCount} Products. One Customer Advantage.</h2>
      <p class="mx-auto mb-2 max-w-2xl">
        Whether you're printing at home, running a home office or equipping your business,
        there's an Epson Advantage product for you.
      </p>
      <p class="mb-5 font-semibold text-text-dark">
        Find yours and enjoy your Print-IQ customer price today.
      </p>
      <PEAPromoBanner class="mx-auto mb-5 max-w-xl" />
      <a href="#shop" class="btn btn-primary">Shop All {productCount} Products</a>
      <div class="mx-auto mt-8 max-w-2xl rounded-md border border-border bg-light p-4 text-sm">
        <p class="mb-1 font-bold text-text-dark">
          Epson Advantage Prices Are Subject to Availability
        </p>
        <p>
          The promotion runs until {promoEndDate} or while stocks last, whichever comes first. Products
          and preferential prices may change based on stock availability and programme availability.
        </p>
      </div>
    </div>
  </section>

  <PEAFAQ />
  <PEAFinalCTA />

  <section class="bg-white py-8">
    <div class="container">
      <div class="mx-auto max-w-4xl space-y-2 text-xs leading-relaxed text-text-light">
        <p>
          The Print-IQ Epson Advantage Program is offered by Print-IQ Singapore Pte Ltd to eligible
          Print-IQ customers. The programme currently applies to selected Epson products only.
        </p>
        <p>
          Percentage savings vary by model and are calculated by comparing the applicable Print-IQ
          Epson Advantage selling price against the standard retail price used for that product at
          the time the offer is published. Prices and savings may change without prior notice.
        </p>
        <p>
          All purchases are subject to product availability, payment confirmation and applicable
          terms and conditions. Product images are for illustration purposes.
        </p>
        <p>
          Epson and associated trademarks are the property of Seiko Epson Corporation and/or its
          affiliates.
        </p>
      </div>
    </div>
  </section>
</Base>
