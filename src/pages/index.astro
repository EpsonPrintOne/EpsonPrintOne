---
import Accordion from "@/helpers/Accordion";
import DynamicIcon from "@/helpers/DynamicIcon";
import Base from "@/layouts/Base.astro";
import PlanCard from "@/components/PlanCard.astro";
import { getListPage } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import { featuredPlan, formatMonthlyPages, plans } from "@/data/plans";
import { Image } from "astro:assets";

const homepage = await getListPage("homepage", "-index");

const {
  hero,
  trust_strip,
  how_it_works,
  plans_section,
  included_services,
  ownership_comparison,
  use_cases,
  sustainability,
  case_study_teaser,
  faq_teaser,
  final_cta,
} = homepage.data;
---

<Base>
  {/* Hero */}
  <section class="pt-20">
    <div class="container">
      <div class="row items-center gy-10">
        <div class="lg:col-6">
          <p
            class="mb-4 font-semibold text-primary dark:text-darkmode-primary"
            set:html={markdownify(hero.tagline)}
          />
          <h1 class="font-primary font-bold" set:html={markdownify(hero.title)} />
          <p class="mt-4 mb-8" set:html={markdownify(hero.subtitle)} />
          <div class="flex flex-wrap gap-4">
            {
              hero.primary_button.enable && (
                <a href={hero.primary_button.link} class="btn-primary">
                  {hero.primary_button.label}
                </a>
              )
            }
            {
              hero.secondary_button.enable && (
                <a
                  href={hero.secondary_button.link}
                  class="btn btn-outline-primary"
                >
                  {hero.secondary_button.label}
                </a>
              )
            }
          </div>
        </div>
        <div class="lg:col-6">
          <Image
            src={featuredPlan.image}
            alt={featuredPlan.model}
            width={700}
            height={560}
            class="mx-auto h-auto w-full max-w-md object-contain"
          />
        </div>
      </div>
    </div>
  </section>

  {/* Trust strip */}
  {
    trust_strip.enable && (
      <section class="section bg-dark dark:bg-darkmode-dark">
        <div class="container">
          <div class="row gy-6 text-center">
            {trust_strip.items.map((item) => (
              <div class="sm:col-4 lg:col-2">
                <DynamicIcon
                  icon={item.icon}
                  className="mx-auto mb-3 h-7 w-7 text-white"
                />
                <p class="text-white/90">{item.label}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {/* How it works */}
  {
    how_it_works.enable && (
      <section class="section">
        <div class="container">
          <h2 class="mb-10 text-center" set:html={markdownify(how_it_works.title)} />
          <div class="row gy-8">
            {how_it_works.steps.map((step, index) => (
              <div class="sm:col-6 lg:col-3 text-center">
                <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-light dark:bg-darkmode-light">
                  <DynamicIcon
                    icon={step.icon}
                    className="h-6 w-6 text-primary dark:text-darkmode-primary"
                  />
                </div>
                <p class="mb-1 text-sm font-semibold text-primary dark:text-darkmode-primary">
                  Step {index + 1}
                </p>
                <p class="text-text-dark dark:text-darkmode-text-dark">
                  {step.text}
                </p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {/* Featured plan */}
  <section class="section bg-light dark:bg-darkmode-light">
    <div class="container">
      <div class="row items-center gy-8 rounded-sm bg-body dark:bg-darkmode-secondary p-8 lg:p-12">
        <div class="lg:col-5 text-center">
          <Image
            src={featuredPlan.image}
            alt={featuredPlan.model}
            width={360}
            height={360}
            class="mx-auto h-56 w-auto object-contain"
          />
        </div>
        <div class="lg:col-7">
          <span class="mb-4 inline-block rounded-full bg-primary dark:bg-darkmode-primary px-4 py-1 text-sm font-medium text-white">
            Highly Recommended
          </span>
          <h2 class="mb-2">{featuredPlan.name}</h2>
          <p class="mb-4 text-text-light dark:text-darkmode-text-light">
            {featuredPlan.model}
          </p>
          <div class="mb-4">
            <span class="h5">$</span>
            <span class="h2 font-bold text-text-dark dark:text-darkmode-text-dark">
              {featuredPlan.monthlyFee.toFixed(2)}
            </span>
            <span> /month</span>
            <span class="ml-3 text-text-dark dark:text-darkmode-text-dark">
              {formatMonthlyPages(featuredPlan.monthlyPages)}
            </span>
          </div>
          <a href="/pricing" class="btn-primary">
            View Plan
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* Six-plan grid */}
  <section class="section">
    <div class="container">
      <div class="lg:col-7 mx-auto mb-10 text-center">
        <h2 class="mb-4" set:html={markdownify(plans_section.title)} />
        <p set:html={markdownify(plans_section.description)} />
      </div>
      <div class="row gy-8">
        {
          plans.map((plan) => (
            <div class="sm:col-6 lg:col-4">
              <PlanCard plan={plan} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* Included services */}
  {
    included_services.enable && (
      <section class="section bg-light dark:bg-darkmode-light">
        <div class="container">
          <h2 class="mb-10 text-center" set:html={markdownify(included_services.title)} />
          <div class="row gy-8">
            {included_services.items.map((item) => (
              <div class="sm:col-6 lg:col-3 flex items-start space-x-4">
                <DynamicIcon
                  icon={item.icon}
                  className="mt-1 h-6 w-6 flex-none text-primary dark:text-darkmode-primary"
                />
                <p>{item.text}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {/* Ownership comparison */}
  {
    ownership_comparison.enable && (
      <section class="section">
        <div class="container">
          <h2 class="mb-10 text-center" set:html={markdownify(ownership_comparison.title)} />
          <div class="lg:col-8 mx-auto overflow-hidden rounded-sm border border-border dark:border-darkmode-border">
            <div class="row g-0 bg-light dark:bg-darkmode-light py-4 text-center font-semibold text-text-dark dark:text-darkmode-text-dark">
              <div class="col-6">Traditional ownership</div>
              <div class="col-6 text-primary dark:text-darkmode-primary">
                PrintOne
              </div>
            </div>
            {ownership_comparison.rows.map((row) => (
              <div class="row g-0 border-t border-border dark:border-darkmode-border py-4 text-center">
                <div class="col-6">{row.traditional}</div>
                <div class="col-6 font-medium text-text-dark dark:text-darkmode-text-dark">
                  {row.printone}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {/* Use cases */}
  {
    use_cases.enable && (
      <section class="section bg-light dark:bg-darkmode-light">
        <div class="container">
          <h2 class="mb-10 text-center" set:html={markdownify(use_cases.title)} />
          <div class="row gy-8">
            {use_cases.items.map((item) => (
              <div class="lg:col-4">
                <div class="h-full rounded-sm bg-body dark:bg-darkmode-secondary p-8 text-center">
                  <DynamicIcon
                    icon={item.icon}
                    className="mx-auto mb-4 h-8 w-8 text-primary dark:text-darkmode-primary"
                  />
                  <h4 class="mb-3">{item.title}</h4>
                  <p>{item.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {/* Sustainability */}
  {
    sustainability.enable && (
      <section class="section">
        <div class="container">
          <div class="row items-center gy-8">
            <div class="lg:col-6">
              <Image
                src={sustainability.image}
                alt="Epson EcoTank printer"
                width={600}
                height={480}
                class="mx-auto h-72 w-auto object-contain"
              />
            </div>
            <div class="lg:col-6">
              <h2 class="mb-4" set:html={markdownify(sustainability.title)} />
              <p class="mb-6" set:html={markdownify(sustainability.description)} />
              <ul class="space-y-3">
                {sustainability.points.map((point) => (
                  <li class="flex items-start space-x-3">
                    <DynamicIcon
                      icon="FaLeaf"
                      className="mt-1 h-4 w-4 flex-none text-primary dark:text-darkmode-primary"
                    />
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </section>
    )
  }

  {/* Case studies (pending approved content) */}
  {
    case_study_teaser.enable && (
      <section class="section bg-light dark:bg-darkmode-light">
        <div class="container text-center">
          <h2 class="mb-4" set:html={markdownify(case_study_teaser.title)} />
          <p set:html={markdownify(case_study_teaser.description)} />
        </div>
      </section>
    )
  }

  {/* FAQ teaser */}
  {
    faq_teaser.enable && (
      <section class="section">
        <div class="container">
          <h2 class="mb-10 text-center" set:html={markdownify(faq_teaser.title)} />
          <div class="row justify-center">
            <Accordion questions={faq_teaser.questions} client:load />
          </div>
          <div class="mt-10 text-center">
            <a href={faq_teaser.link} class="btn btn-outline-primary">
              View all FAQs
            </a>
          </div>
        </div>
      </section>
    )
  }

  {/* Final CTA */}
  {
    final_cta.enable && (
      <section class="section bg-dark dark:bg-darkmode-dark">
        <div class="container text-center">
          <h2 class="mb-4 text-white" set:html={markdownify(final_cta.title)} />
          <p class="mb-8 text-white/80" set:html={markdownify(final_cta.description)} />
          {final_cta.button.enable && (
            <a href={final_cta.button.link} class="btn-primary">
              {final_cta.button.label}
            </a>
          )}
        </div>
      </section>
    )
  }
</Base>
