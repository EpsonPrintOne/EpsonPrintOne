---
import { getListPage } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import { Image } from "astro:assets";

const testimonial = await getListPage("testimonialSection", "testimonial");
const { description, title, enable, testimonials } = testimonial.data;
---

{
  enable && (
    <section class="section bg-light dark:bg-darkmode-light">
      <div class="container">
        <div class="lg:col-6 mx-auto text-center mb-8 lg:mb-16">
          <h2 class="mb-5" set:html={markdownify(title)} />
          <p set:html={markdownify(description)} />
        </div>

        <div class="sm:col-10 mx-auto">
          <div class="swiper testimonial-slider">
            <div class="swiper-wrapper">
              {testimonials.map((t) => (
                <div class="swiper-slide text-center">
                  <p
                    class="h5 text-text-dark dark:text-darkmode-text-dark"
                    set:html={markdownify(t.content!)}
                  />
                  <Image
                    class="inline-block rounded-full mt-12"
                    src={t.avatar}
                    width={80}
                    height={80}
                    alt={t.name}
                  />
                  <h4 class="mt-3 font-bold" set:html={markdownify(t.name)} />
                  <p class="mt-1" set:html={markdownify(t.designation)} />
                </div>
              ))}
            </div>
            <div class="pagination mt-8 lg:mt-16" />
          </div>
        </div>
      </div>
    </section>
  )
}

<script>
  import { Swiper } from "swiper";
  import "swiper/css";
  import { Pagination } from "swiper/modules";

  // astro:page-load event is fired when the page is loaded
  document.addEventListener("astro:page-load", () => {
    new Swiper(".testimonial-slider", {
      modules: [Pagination],
      spaceBetween: 52,
      loop: true,
      // loopedSlides: 2,
      slidesPerView: 1,
      pagination: {
        el: ".pagination",
        clickable: true,
        bulletActiveClass: "active",
      },
      breakpoints: {
        991: {
          slidesPerView: 2,
        },
      },
    });
  });
</script>
