{
  "name": "epsonprintonecloudflare",
  "compatibility_date": "2026-03-01",
  "main": "worker/index.ts",
  "vars": {
    "ENQUIRY_NOTIFICATION_EMAIL": "enquiries@epsonprintone.com",
    "SUBSCRIBER_NOTIFICATION_EMAIL": "deployment@print-iq.com.sg"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "printone-subscribers",
      "database_id": "8f66bf6d-3cf0-4bf3-ada3-5d4bb2d69040"
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS"
  }
}
