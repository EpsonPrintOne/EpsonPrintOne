---
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser.astro";
import PageHeader from "@/partials/PageHeader.astro";
import { plans } from "@/data/plans";
import { render } from "astro:content";

const contactIndex = await getListPage("contact", "-index");
const buildDrafts = process.argv.includes("--buildDrafts");
if (!buildDrafts && contactIndex.data.draft) return Astro.redirect("/404");
const { title, description, meta_title, image } = contactIndex.data;
const { Content } = await render(contactIndex);
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
>
  <PageHeader title={title} />
  <section class="section-sm">
    <div class="container">
      <div class="row gy-4 lg:gy-0">
        <div class="lg:col-6">
          <div class="content">
            <Content />
          </div>
        </div>
        <div class="lg:col-6">
          <form id="enquiry-form" class="row" novalidate>
            {/* honeypot - left blank by humans, hidden from assistive tech and sighted users */}
            <div class="absolute -left-[9999px]" aria-hidden="true">
              <label for="website">Leave this field blank</label>
              <input
                type="text"
                id="website"
                name="website"
                tabindex={-1}
                autocomplete="off"
              />
            </div>

            <div
              id="enquiry-error"
              class="col-12 hidden rounded-sm border border-red-300 bg-red-50 p-4 text-sm text-red-700"
              role="alert"
            >
            </div>
            <div
              id="enquiry-success"
              class="col-12 hidden rounded-sm border border-primary/30 bg-light dark:bg-darkmode-light p-6 text-center"
              role="status"
            >
              <p class="h5 mb-2 text-text-dark dark:text-darkmode-text-dark">
                Thanks — your enquiry has been sent.
              </p>
              <p>Print-IQ will get back to you using your preferred contact method.</p>
            </div>

            <div id="enquiry-fields" class="row">
              <div class="lg:col-6">
                <label for="name">
                  <div class="mb-2 font-medium text-text-dark dark:text-darkmode-text-dark">
                    Full Name <span class="text-red-500">*</span>
                  </div>
                  <input
                    class="blcok border border-border w-full rounded-sm p-3 focus:border-primary focus:outline-none focus:ring-0 focus:shadow-none transition dark:bg-dark/20 dark:border-darkmode-border dark:focus:border-darkmode-primary placeholder:text-darkmode-text-light"
                    type="text"
                    id="name"
                    name="name"
                    placeholder="Full Name"
                    autocomplete="name"
                    required
                  />
                </label>
              </div>
              <div class="lg:col-6 mt-6 lg:mt-0">
                <label for="mobile">
                  <div class="mb-2 font-medium text-text-dark dark:text-darkmode-text-dark">
                    Mobile Number <span class="text-red-500">*</span>
                  </div>
                  <input
                    class="blcok border border-border w-full rounded-sm p-3 focus:border-primary focus:outline-none focus:ring-0 focus:shadow-none transition dark:bg-dark/20 dark:border-darkmode-border dark:focus:border-darkmode-primary placeholder:text-darkmode-text-light"
                    type="tel"
                    id="mobile"
                    name="mobile"
                    placeholder="Mobile Number"
                    autocomplete="tel"
                    required
                  />
                </label>
              </div>

              <div class="col-12 mt-6">
                <label for="email">
                  <div class="mb-2 font-medium text-text-dark dark:text-darkmode-text-dark">
                    Email Address <span class="text-red-500">*</span>
                  </div>
                  <input
                    class="blcok border border-border w-full rounded-sm p-3 focus:border-primary focus:outline-none focus:ring-0 focus:shadow-none transition dark:bg-dark/20 dark:border-darkmode-border dark:focus:border-darkmode-primary placeholder:text-darkmode-text-light"
                    type="email"
                    id="email"
                    name="email"
                    placeholder="Email Address"
                    autocomplete="email"
                    required
                  />
                </label>
              </div>

              <div class="lg:col-6 mt-6">
                <label for="customer_type">
                  <div class="mb-2 font-medium text-text-dark dark:text-darkmode-text-dark">
                    Customer Type <span class="text-red-500">*</span>
                  </div>
                  <select
                    id="customer_type"
                    name="customer_type"
                    class="blcok border border-border w-full rounded-sm p-3 focus:border-primary focus:outline-none focus:ring-0 focus:shadow-none transition dark:bg-dark/20 dark:border-darkmode-border dark:focus:border-darkmode-primary"
                    required
                  >
                    <option value="">Select one</option>
                    <option value="home">Home</option>
                    <option value="business">Business</option>
                  </select>
                </label>
              </div>

              <div class="lg:col-6 mt-6">
                <label for="plan">
                  <div class="mb-2 font-medium text-text-dark dark:text-darkmode-text-dark">
                    Selected Plan <span class="text-red-500">*</span>
                  </div>
                  <select
                    id="plan"
                    name="plan"
                    class="blcok border border-border w-full rounded-sm p-3 focus:border-primary focus:outline-none focus:ring-0 focus:shadow-none transition dark:bg-dark/20 dark:border-darkmode-border dark:focus:border-darkmode-primary"
                    required
                  >
                    <option value="">Select one</option>
                    {plans.map((plan) => <option value={plan.slug}>{plan.name}</option>)}
                    <option value="not-sure">Not sure yet</option>
                  </select>
                </label>
              </div>

              <div class="lg:col-6 mt-6">
                <label for="postal_code">
                  <div class="mb-2 font-medium text-text-dark dark:text-darkmode-text-dark">
                    Singapore Postal Code <span class="text-red-500">*</span>
                  </div>
                  <input
                    class="blcok border border-border w-full rounded-sm p-3 focus:border-primary focus:outline-none focus:ring-0 focus:shadow-none transition dark:bg-dark/20 dark:border-darkmode-border dark:focus:border-darkmode-primary placeholder:text-darkmode-text-light"
                    type="text"
                    id="postal_code"
                    name="postal_code"
                    placeholder="e.g. 238859"
                    inputmode="numeric"
                    pattern="[0-9]{6}"
                    title="6-digit Singapore postal code"
                    autocomplete="postal-code"
                    required
                  />
                </label>
              </div>

              <div class="lg:col-6 mt-6">
                <label for="contact_method">
                  <div class="mb-2 font-medium text-text-dark dark:text-darkmode-text-dark">
                    Preferred Contact Method <span class="text-red-500">*</span>
                  </div>
                  <select
                    id="contact_method"
                    name="contact_method"
                    class="blcok border border-border w-full rounded-sm p-3 focus:border-primary focus:outline-none focus:ring-0 focus:shadow-none transition dark:bg-dark/20 dark:border-darkmode-border dark:focus:border-darkmode-primary"
                    required
                  >
                    <option value="">Select one</option>
                    <option value="phone">Phone</option>
                    <option value="email">Email</option>
                    <option value="whatsapp">WhatsApp</option>
                  </select>
                </label>
              </div>

              <div class="col-12 mt-6">
                <label for="message">
                  <div class="mb-2 font-medium text-text-dark dark:text-darkmode-text-dark">
                    Message or Installation Requirement
                  </div>
                  <textarea
                    rows={4}
                    class="blcok border border-border w-full rounded-sm p-3 focus:border-primary focus:outline-none focus:ring-0 focus:shadow-none transition dark:bg-dark/20 dark:border-darkmode-border dark:focus:border-darkmode-primary placeholder:text-darkmode-text-light"
                    id="message"
                    name="message"
                    placeholder="Anything else Print-IQ should know?"></textarea>
                </label>
              </div>

              <div class="col-12 mt-6">
                <label class="flex items-start gap-3">
                  <input
                    type="checkbox"
                    id="consent"
                    name="consent"
                    class="mt-1"
                    required
                  />
                  <span>
                    I consent to be contacted by Print-IQ Singapore Pte Ltd about
                    this enquiry. <span class="text-red-500">*</span>
                  </span>
                </label>
              </div>

              <div class="col-12">
                <button
                  id="enquiry-submit"
                  type="submit"
                  class="btn btn-primary mt-8"
                >
                  Send Enquiry
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  document.addEventListener("astro:page-load", () => {
    const form = document.getElementById("enquiry-form") as HTMLFormElement | null;
    if (!form) return;

    const fieldsWrap = document.getElementById("enquiry-fields")!;
    const successBox = document.getElementById("enquiry-success")!;
    const errorBox = document.getElementById("enquiry-error")!;
    const submitBtn = document.getElementById(
      "enquiry-submit",
    ) as HTMLButtonElement;

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      errorBox.classList.add("hidden");
      errorBox.textContent = "";

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const formData = new FormData(form);
      const payload = {
        name: formData.get("name"),
        mobile: formData.get("mobile"),
        email: formData.get("email"),
        customer_type: formData.get("customer_type"),
        plan: formData.get("plan"),
        postal_code: formData.get("postal_code"),
        contact_method: formData.get("contact_method"),
        message: formData.get("message"),
        consent: formData.get("consent") === "on",
        website: formData.get("website"),
      };

      submitBtn.disabled = true;
      const originalLabel = submitBtn.textContent;
      submitBtn.textContent = "Sending...";

      try {
        const response = await fetch("/api/enquiry", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });

        if (!response.ok) {
          const data = await response.json().catch(() => null);
          const message =
            (data && data.error) ||
            "Something went wrong sending your enquiry. Please try again.";
          errorBox.textContent = message;
          errorBox.classList.remove("hidden");
          submitBtn.disabled = false;
          submitBtn.textContent = originalLabel;
          return;
        }

        fieldsWrap.classList.add("hidden");
        successBox.classList.remove("hidden");
      } catch {
        errorBox.textContent =
          "Something went wrong sending your enquiry. Please try again.";
        errorBox.classList.remove("hidden");
        submitBtn.disabled = false;
        submitBtn.textContent = originalLabel;
      }
    });
  });
</script>
