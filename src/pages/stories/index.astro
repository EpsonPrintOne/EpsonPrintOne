---
import StoryCard from "@/components/StoryCard.astro";
import Pagination from "@/components/Pagination.astro";
import { settings } from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import { getListPage, getSinglePage } from "@/lib/contentParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";
import PageHeader from "@/partials/PageHeader.astro";

const { stories_folder, pagination } = settings;

const storiesIndex = await getListPage("stories", "-index");
const buildDrafts = process.argv.includes("--buildDrafts");
if (!buildDrafts && storiesIndex.data.draft) return Astro.redirect("/404");
const stories = await getSinglePage("stories");
const sortedStories = sortByDate(stories);
const currentStories = sortedStories.slice(0, pagination);
const totalPages = Math.ceil(stories.length / pagination);
---

<Base {...storiesIndex.data}>
  <PageHeader
    title={storiesIndex.data.title}
    subtitle={storiesIndex.data.subtitle}
  />

  {
    currentStories.length > 0 && (
      <div class="container -mt-6 mb-6 text-center">
        <a
          href={`/${stories_folder}/${currentStories[0].id}`}
          class="btn btn-primary"
        >
          Read the Latest Story
        </a>
      </div>
    )
  }

  <section class="section pt-0">
    <div class="container">
      {
        currentStories.length > 0 ? (
          <>
            <div class="row">
              {currentStories.map((story) => (
                <div class="mb-14 md:col-6 lg:col-4">
                  <StoryCard {...story} />
                </div>
              ))}
            </div>
            <Pagination
              section={stories_folder}
              currentPage={1}
              totalPages={totalPages}
            />
          </>
        ) : (
          <div class="lg:col-6 mx-auto py-12 text-center">
            <h3 class="mb-3">New stories every week</h3>
            <p>
              We're gathering real customer experiences to share here — check
              back soon for the first story.
            </p>
          </div>
        )
      }
    </div>
  </section>
</Base>
