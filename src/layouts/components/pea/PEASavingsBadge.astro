---
interface Props {
  percentage: number;
  size?: "sm" | "lg";
}

const { percentage, size = "sm" } = Astro.props;
---

<span
  class:list={[
    "inline-block rounded-full bg-red-600 font-extrabold uppercase tracking-wide text-white shadow-md",
    size === "lg" ? "px-4 py-1.5 text-base" : "px-3 py-1 text-xs",
  ]}
>
  Save {percentage}%
</span>
