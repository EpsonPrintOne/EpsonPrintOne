---
import { promoDetail, promoHeadline } from "@/data/epsonAdvantageProducts";

interface Props {
  variant?: "strip" | "light" | "dark";
  class?: string;
}

const { variant = "light", class: className = "" } = Astro.props;
const styles = {
  strip: "bg-red-600 text-white text-sm py-2 px-4",
  light: "border border-red-200 bg-red-50 text-red-700 rounded-md px-4 py-3",
  dark: "bg-white/10 border border-white/30 text-white rounded-md px-4 py-3",
};
---

<p class:list={["text-center font-semibold leading-snug", styles[variant], className]}>
  <span class="font-extrabold uppercase tracking-wide">{promoHeadline}</span>{" "}{promoDetail}
</p>
