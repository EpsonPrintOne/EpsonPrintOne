---
import { maxDiscount, productCount } from "@/data/epsonAdvantageProducts";
---

<section class="bg-primary py-14 text-center text-white">
  <div class="container">
    <h2 class="mb-3 text-white">Your Print-IQ Relationship Now Gives You More.</h2>
    <p class="mb-1 text-xl text-white/90">
      Enjoy special pricing on {productCount} selected Epson products.
    </p>
    <p class="mb-6 text-2xl font-extrabold text-white">
      Save up to {maxDiscount}% off standard retail prices.
    </p>
    <a
      href="#shop"
      class="inline-block rounded-full bg-white px-8 py-3 text-base font-bold uppercase tracking-wide text-primary transition hover:bg-light"
    >
      Shop Epson Advantage
    </a>
    <p class="mt-4 text-sm text-white/80">
      Exclusive pricing for eligible Print-IQ customers • While stocks last • Terms apply
    </p>
  </div>
</section>
